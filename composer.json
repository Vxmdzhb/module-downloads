{
    "name": "astrx/module-downloads",
    "description": "Signed release downloads page with its admin editor",
    "license": "LicenseRef-DoWhatever",
    "type": "astrx-module",
    "keywords": [
        "astrx",
        "no-javascript",
        "server-rendered",
        "astrx-module"
    ],
    "homepage": "https://github.com/Vxmdzhb/module-downloads",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "astrx/auth": "self.version",
        "astrx/cms": "self.version",
        "astrx/csrf": "self.version",
        "astrx/http": "self.version",
        "astrx/i18n": "self.version",
        "astrx/kernel": "self.version",
        "astrx/module": "self.version",
        "astrx/result": "self.version",
        "astrx/session": "self.version",
        "astrx/template": "self.version"
    },
    "suggest": {
        "ext-sodium": "Signs and verifies the release manifest (the page refuses to run without it)"
    },
    "autoload": {
        "psr-4": {
            "AstrX\\Downloads\\": ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
